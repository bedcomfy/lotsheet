{
  "name": "lotsheet",
  "version": "0.25.2",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:ui": "vitest run --project=storybook",
    "test:visual": "playwright test --config playwright.ui.config.ts",
    "test:visual:update": "playwright test --config playwright.ui.config.ts --update-snapshots",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "tsc --noEmit && vitest run && storybook build --quiet && next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sheet:new": "node scripts/new-sheet.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.4",
    "@sparticuz/chromium": "^131.0.1",
    "@tanstack/react-query": "^5.101.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "puppeteer-core": "^23.11.1",
    "react": "19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "playwright": "^1.61.1",
    "storybook": "^10.5.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
